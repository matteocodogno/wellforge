  "author": {
    "name": "WellForge"
  },
  "homepage": "https://github.com/matteocodogno/wellforge",
  "repository": "https://github.com/matteocodogno/wellforge",
  "license": "MIT",
  "keywords": [
    "spec-driven",
    "multi-agent",
    "quality-gates",
    "copier",
    "scaffolding",
    "kotlin",
    "spring-boot",
    "hono",
    "pulumi",
    "react",
    "typescript",
    "owasp",
    "adr",
    "playwright",
    "monorepo",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "onboardingSkill": "./skills/wf-setup/SKILL.md",
      "interface": {
        "displayName": "WellForge",
        "shortDescription": "Spec-driven workflow, a role-based agent team and enforced quality gates for Codex.",
        "developerName": "WellForge",
        "category": "Coding",
        "websiteURL": "https://github.com/matteocodogno/wellforge"
      }
    }
  }
}
