{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.82"
      ]
    },
    "context-hub": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "@aisuite/chub@0.1.4",
        "chub-mcp"
      ]
    }
  }
}
