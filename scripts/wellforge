#!/usr/bin/env bash
# wellforge — install, check, and update the WellForge environment on a Mac.
#
#   wellforge setup     full setup: doctor --fix, repo clone/update, plugin install
#   wellforge doctor    check the environment (add --fix to install/upgrade tools)
#   wellforge update    update repo + tools + plugin
#   wellforge telegram  configure Telegram notifications (guided, step by step)
#   wellforge version   print CLI + checkout versions (also: --version, -v)
#
# Env overrides:
#   WELLFORGE_HOME  checkout location (default ~/.ai/wellforge; setup asks and
#                   remembers your choice; an enclosing checkout wins when the
#                   script is run from inside one)
#   WELLFORGE_REPO  git URL/path to clone from
#                   (default https://github.com/matteocodogno/wellforge.git)
# NO `set -e`, deliberately. This is a DIAGNOSTICS tool: every external command it runs
# (brew, git, claude, grep on a file that may not exist) can legitimately fail, and the
# right response is to report that line and keep checking — not to abort mid-run and print
# nothing. `set -e` did the opposite: `wellforge doctor` on a machine with no checkout died
# silently at the plugin check with rc=2, hiding the summary and the "run: wellforge setup"
# advice — exactly the machine that needed them. Every call below reports its own outcome.
set -uo pipefail

WELLFORGE_REPO="${WELLFORGE_REPO:-https://github.com/matteocodogno/wellforge.git}"
CONFIG_DIR="$HOME/.config/wellforge"
CONFIG_FILE="$CONFIG_DIR/config"           # remembers the chosen install location
TELEGRAM_ENV_FILE="$CONFIG_DIR/telegram.env"

# ─── ui ──────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  GRN=$'\033[32m'; RED=$'\033[31m'; YLW=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'
else
  GRN=""; RED=""; YLW=""; DIM=""; RST=""
fi
ok()   { printf "  %s✓%s %-18s %s\n" "$GRN" "$RST" "$1" "${2:-}"; }
bad()  { printf "  %s✗%s %-18s %s\n" "$RED" "$RST" "$1" "${2:-}"; }
warn() { printf "  %s!%s %-18s %s\n" "$YLW" "$RST" "$1" "${2:-}"; }
# A check that could not run is NOT a check that passed. Silence here reads as "fine",
# which is how a truncated report gets mistaken for a clean one.
skip() { printf "  %s–%s %-18s %s%s%s\n" "$DIM" "$RST" "$1" "$DIM" "${2:-}" "$RST"; }
say()  { printf "%s\n" "$*"; }
die()  { printf "%serror:%s %s\n" "$RED" "$RST" "$*" >&2; exit 1; }

# ─── home resolution ─────────────────────────────────────────────────────────
script_repo() {
  # If this script lives inside a wellforge checkout, prefer it.
  local src dir
  src="${BASH_SOURCE[0]}"
  dir="$(cd "$(dirname "$src")/.." 2>/dev/null && pwd)" || return 1
  [ -f "$dir/.claude-plugin/marketplace.json" ] && echo "$dir"
}
# Resolution order: env var > enclosing checkout > saved choice > default ~/.ai
WELLFORGE_HOME="${WELLFORGE_HOME:-$(script_repo)}"
if [ -z "$WELLFORGE_HOME" ] && [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi
WELLFORGE_HOME="${WELLFORGE_HOME:-$HOME/.ai/wellforge}"

# ─── tool checks ─────────────────────────────────────────────────────────────
BREW_TOOLS=(mise uv gh jq)
FAILURES=0

check_brew() {
  if command -v brew >/dev/null; then ok "homebrew" "$(brew --version 2>/dev/null | head -1 || echo '?')"; else
    bad "homebrew" 'install first: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
    FAILURES=$((FAILURES+1)); return 1
  fi
}

# The last line of a failed command's stderr is usually the only part that explains WHY
# (no such formula, disk full, locked keychain). Hiding it behind >/dev/null left the user
# with a bare "failed" and nothing to act on, so callers capture stderr and quote this.
err_tail() { printf '%s' "${1:-}" | tail -1; }

check_tool() { # name [fix]
  local t="$1" fix="${2:-}" err
  if command -v "$t" >/dev/null; then
    if [ -n "$fix" ] && command -v brew >/dev/null && brew outdated --quiet 2>/dev/null | grep -qx "$t"; then
      say "  ${DIM}upgrading ${t}…${RST}"
      if err=$(brew upgrade "$t" 2>&1 >/dev/null); then
        ok "$t" "upgraded → $("$t" --version 2>/dev/null | head -1 || echo '?')"
      else
        # An upgrade that fails is not a missing tool: the old version still works, so
        # this is a warning, not a counted failure.
        warn "$t" "upgrade failed, keeping $("$t" --version 2>/dev/null | head -1 || echo 'current') — $(err_tail "$err") — retry: brew upgrade $t"
      fi
    else
      ok "$t" "$("$t" --version 2>/dev/null | head -1 || echo '?')"
    fi
  elif [ -n "$fix" ] && ! command -v brew >/dev/null; then
    bad "$t" "not installed, and --fix needs Homebrew to install it — install brew first"
    FAILURES=$((FAILURES+1))
  elif [ -n "$fix" ]; then
    say "  ${DIM}installing ${t}…${RST}"
    if err=$(brew install "$t" 2>&1 >/dev/null); then
      ok "$t" "installed"
    else
      bad "$t" "brew install $t failed: $(err_tail "$err")"
      FAILURES=$((FAILURES+1))
    fi
  else
    bad "$t" "brew install $t"; FAILURES=$((FAILURES+1))
  fi
}

check_claude() { # [fix]
  local err
  if command -v claude >/dev/null; then
    ok "claude" "$(claude --version 2>/dev/null | head -1 || echo '?')"; return
  fi
  if [ -n "${1:-}" ] && command -v npm >/dev/null; then
    say "  ${DIM}installing claude code via npm…${RST}"
    if err=$(npm install -g @anthropic-ai/claude-code 2>&1 >/dev/null); then
      ok "claude" "installed"; return
    fi
    bad "claude" "npm install failed: $(err_tail "$err")"
    FAILURES=$((FAILURES+1)); return
  fi
  bad "claude" "npm i -g @anthropic-ai/claude-code  (or the desktop app)"
  FAILURES=$((FAILURES+1))
}

check_node() { # [fix] — npx is needed by the plugin's MCP servers
  local err
  if command -v npx >/dev/null; then
    ok "node/npx" "node $(node --version 2>/dev/null || echo '?')"; return
  fi
  if [ -n "${1:-}" ]; then
    if ! command -v mise >/dev/null; then
      bad "node/npx" "cannot install: mise is missing too — brew install mise, then re-run"
      FAILURES=$((FAILURES+1)); return
    fi
    say "  ${DIM}installing node via mise…${RST}"
    if err=$(mise use -g node@22 2>&1 >/dev/null); then
      ok "node/npx" "installed via mise"; return
    fi
    bad "node/npx" "mise use -g node@22 failed: $(err_tail "$err")"
    FAILURES=$((FAILURES+1)); return
  fi
  bad "node/npx" "mise use -g node@22  (MCP servers run via npx)"
  FAILURES=$((FAILURES+1))
}

check_docker() {
  if command -v docker >/dev/null; then
    if docker info >/dev/null 2>&1; then ok "docker" "daemon running"; else warn "docker" "installed but not running — start Docker Desktop"; fi
  else
    warn "docker" "not found — needed for local postgres/Testcontainers: brew install --cask docker-desktop"
  fi
}

check_gh_auth() {
  command -v gh >/dev/null || { skip "gh auth" "skipped — gh not installed"; return 0; }
  # NOTE: `gh auth status` is not a local check — it reads the token from the
  # keychain and verifies it against the GitHub API. Distinguish the failure
  # modes instead of mislabeling them all as "not logged in".
  local out
  if out=$(gh auth status 2>&1); then
    ok "gh auth" "authenticated"
  elif echo "$out" | grep -q "Logged in to"; then
    warn "gh auth" "logged in, but verification failed (locked keychain / network / a second expired account?) — retry, or: gh auth status"
  elif grep -qs 'plugin run -- gh' "$HOME/.config/op/plugins.sh"; then
    # 1Password shell plugin: gh is aliased to `op plugin run -- gh` in the
    # INTERACTIVE shell only — raw gh (used by scripts, hooks, and Claude Code
    # sessions) has no credentials.
    warn "gh auth" "gh works in your shell via the 1Password plugin, but scripts & Claude Code call raw gh, which has no token — run 'gh auth login' once to cover automation too"
  else
    warn "gh auth" "not logged in — run: gh auth login (needed by the connections layer)"
  fi
}

check_copier() {
  command -v uvx >/dev/null || { skip "copier (uvx)" "skipped — uv/uvx not installed"; return 0; }
  if uvx copier --version >/dev/null 2>&1; then ok "copier (uvx)" "$(uvx copier --version 2>/dev/null || echo '?')"; else
    warn "copier (uvx)" "uvx present but copier failed to run — check network/proxy"
  fi
}

check_repo() {
  if [ ! -f "$WELLFORGE_HOME/.claude-plugin/marketplace.json" ]; then
    bad "wellforge repo" "not at $WELLFORGE_HOME — run: wellforge setup (with WELLFORGE_REPO=<url>)"
    FAILURES=$((FAILURES+1)); return
  fi
  local desc; desc="$(git -C "$WELLFORGE_HOME" describe --tags --match 'v*' --always 2>/dev/null || echo '?')"
  ok "wellforge repo" "$WELLFORGE_HOME ($desc)"

  # Checkout freshness vs origin — this is the channel where plugin features land
  # (commands/agents/skills), distinct from the brew CLI. A quiet fetch keeps the
  # recurring "am I up to date?" question honest. Skipped if no upstream / offline.
  local up behind
  up="$(git -C "$WELLFORGE_HOME" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" || { warn "checkout" "no upstream tracked — can't check for plugin updates"; return; }
  git -C "$WELLFORGE_HOME" fetch --quiet 2>/dev/null || { warn "checkout" "couldn't reach $up (offline?) — skipped update check"; return; }
  behind="$(git -C "$WELLFORGE_HOME" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  if [ "$behind" = "0" ]; then
    ok "checkout" "current with $up"
  else
    warn "checkout" "$behind commit(s) behind $up — plugin features may be stale; run: wellforge update (then /reload-plugins)"
  fi
}

# Version string from a plugin.json that may not exist. THE original bug lived here:
# `grep … 2>/dev/null | sed …` on a missing file exits 2, pipefail propagated it, and an
# assignment from a failing substitution was fatal under set -e — so `doctor` died right
# after the plugin line, on exactly the machine that had no checkout yet. A missing file is
# a NORMAL state for this tool, so it is answered with "", never with a failing pipeline.
plugin_json_version() { # <path-to-plugin.json> → version, or "" when unreadable
  [ -f "$1" ] || return 0
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -1
}

check_plugin() {
  command -v claude >/dev/null || { skip "plugin" "skipped — claude not installed"; return 0; }
  if claude plugin marketplace list 2>/dev/null | grep -q "wellforge"; then ok "marketplace" "WellForge registered"; else
    bad "marketplace" "run: claude plugin marketplace add $WELLFORGE_HOME"; FAILURES=$((FAILURES+1))
  fi
  if claude plugin list 2>/dev/null | grep -q "wellforge"; then ok "plugin" "wellforge installed"; else
    bad "plugin" "run: claude plugin install wellforge@wellforge --scope user"; FAILURES=$((FAILURES+1))
  fi
  # Loaded-plugin freshness: the running plugin is a version-keyed cache copy, not the
  # source. Compare the newest cached version to the source plugin.json version — they
  # diverge when source moved ahead but no reinstall happened (update+reload don't refresh).
  local cache_root="$HOME/.claude/plugins/cache/wellforge/wellforge"
  local src_ver cached_ver
  src_ver=$(plugin_json_version "$WELLFORGE_HOME/wellforge-plugin/.claude-plugin/plugin.json")
  if [ -n "$src_ver" ] && [ -d "$cache_root" ]; then
    cached_ver=$(ls "$cache_root" 2>/dev/null | sort -t. -k1,1n -k2,2n -k3,3n | tail -1) || cached_ver=""
    if [ -n "$cached_ver" ] && [ "$cached_ver" != "$src_ver" ]; then
      warn "plugin cache" "loaded v$cached_ver but source is v$src_ver — run: wellforge update (reinstalls), then /reload-plugins"
    else
      ok "plugin cache" "v${cached_ver:-?} matches source"
    fi
  fi
}

# Detect pre-existing user components that clash with WellForge's — advisory (warns,
# never fails). Reserved names come from the plugin itself (no drift). Scans the user's
# global (~/.claude) and, when run from a project, project-local (.claude) config.
# Move a colliding loose component to a reversible backup (never delete user content).
# Prompts only when --fix is set AND interactive; otherwise advisory. Returns 0 if resolved.
collision_resolve() {  # <path> <kind: agent|skill> <name> <label> <fix>
  local path="$1" kind="$2" name="$3" label="$4" fix="$5"
  if [ -z "$fix" ] || [ ! -t 0 ]; then
    warn "collision" "$label $kind '$name' shares a WellForge $kind name${kind:+ — run 'wellforge doctor --fix' to disable it}"
    return 1
  fi
  local backup; backup="$(dirname "$path")-disabled-by-wellforge"
  printf "  disable %s %s '%s'? WellForge keeps wellforge:%s; moves to %s (reversible) [y/N] " "$label" "$kind" "$name" "$name" "$backup"
  read -r ans
  case "$ans" in
    y|Y|yes)
      mkdir -p "$backup" 2>/dev/null && mv "$path" "$backup/" 2>/dev/null \
        && { ok "fixed" "$label $kind '$name' disabled → $backup/ (mv back to re-enable)"; return 0; } \
        || { warn "collision" "couldn't move $path — disable it manually"; return 1; } ;;
    *) warn "collision" "$label $kind '$name' kept — overlaps WellForge's"; return 1 ;;
  esac
}

check_collisions() {
  local fix="${1:-}"
  command -v claude >/dev/null || { skip "collisions" "skipped — claude not installed"; return 0; }
  local plugin="$WELLFORGE_HOME/wellforge-plugin"
  # Reserved names come from the plugin itself, so with no checkout there is nothing to
  # compare against. Say that, rather than printing nothing and letting the reader assume
  # a clean result — this is precisely the line the truncated report used to lose.
  [ -d "$plugin" ] || { skip "collisions" "skipped — no plugin source at $plugin"; return 0; }
  local found=0

  # Each of these can come back empty on a partial checkout, and empty is a correct
  # answer: "nothing of that kind to collide with". jq exits non-zero on a missing or
  # malformed file, so each gets its fallback spelled out rather than inherited.
  local wf_agents wf_skills wf_mcp wf_events
  wf_agents=$(for f in "$plugin"/agents/*.md; do [ -e "$f" ] && basename "$f" .md; done) || wf_agents=""
  wf_skills=$(for d in "$plugin"/skills/*/; do [ -d "$d" ] && basename "$d"; done) || wf_skills=""
  wf_mcp=$(jq -r '.mcpServers|keys[]' "$plugin/.mcp.json" 2>/dev/null) || wf_mcp=""
  wf_events=$(jq -r '.hooks|keys[]' "$plugin/hooks/hooks.json" 2>/dev/null) || wf_events=""

  local scopes=("$HOME/.claude:global"); [ -d ".claude" ] && scopes+=(".claude:project")
  for sc in "${scopes[@]}"; do
    local dir="${sc%%:*}" label="${sc##*:}"
    for f in "$dir"/agents/*.md; do
      [ -e "$f" ] || continue
      local n; n=$(basename "$f" .md)
      echo "$wf_agents" | grep -qx "$n" && { collision_resolve "$f" agent "$n" "$label" "$fix" || found=1; }
    done
    for d in "$dir"/skills/*/; do
      [ -d "$d" ] || continue
      local n; n=$(basename "$d")
      echo "$wf_skills" | grep -qx "$n" && { collision_resolve "${d%/}" skill "$n" "$label" "$fix" || found=1; }
    done
    local sf="$dir/settings.json"
    if [ -f "$sf" ] && [ -n "$wf_events" ]; then
      local ue; ue=$(jq -r '(.hooks//{})|keys[]' "$sf" 2>/dev/null) || ue=""
      for e in $ue; do
        echo "$wf_events" | grep -qx "$e" && { warn "collision" "$label hook on '$e' runs alongside WellForge's — a blocking hook could interfere (not auto-fixed: it's your config; edit settings.json if needed)"; found=1; }
      done
    fi
  done
  # MCP: project .mcp.json + global ~/.claude.json
  for mf in ".mcp.json" "$HOME/.claude.json"; do
    [ -f "$mf" ] || continue
    local um; um=$(jq -r '(.mcpServers//{})|keys[]' "$mf" 2>/dev/null) || um=""
    for s in $um; do
      echo "$wf_mcp" | grep -qx "$s" && { warn "collision" "MCP server '$s' ($mf) shadows WellForge's (not auto-fixed: it's your config; rename it in $mf if needed)"; found=1; }
    done
  done

  [ "$found" = "0" ] && ok "collisions" "none — no clashing agents/skills/hooks/MCP"
}

# ─── telegram ────────────────────────────────────────────────────────────────
telegram_configured() {
  { [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${TELEGRAM_CHAT_ID:-}" ]; } || [ -f "$TELEGRAM_ENV_FILE" ]
}

tg_api() { # token method [curl args…]
  local token="$1" method="$2"; shift 2
  curl -s --max-time 10 "https://api.telegram.org/bot${token}/${method}" "$@"
}

cmd_telegram() {
  say "Telegram notifications — guided setup"
  say "${DIM}The plugin's notify hook DMs you when Claude needs permission or is waiting.${RST}"
  say ""

  if telegram_configured && [ "${1:-}" != "--reconfigure" ]; then
    # shellcheck source=/dev/null
    [ -f "$TELEGRAM_ENV_FILE" ] && . "$TELEGRAM_ENV_FILE"
    say "Already configured ${DIM}($TELEGRAM_ENV_FILE)${RST}."
    printf "Send a test message now? [Y/n] "; read -r ans
    case "$ans" in n|N) ;; *) tg_test && return 0 || say "${YLW}test failed — re-running setup.${RST}";; esac
    printf "Reconfigure from scratch? [y/N] "; read -r ans
    case "$ans" in y|Y) ;; *) return 0 ;; esac
  fi

  # ── step 1: create a bot ──
  say ""
  say "${YLW}Step 1/3 — create your bot${RST}"
  say "  1. Open Telegram and start a chat with ${GRN}@BotFather${RST}  (opening now…)"
  say "  2. Send:  ${GRN}/newbot${RST}"
  say "  3. Pick any display name, then a username ending in ${DIM}bot${RST} (e.g. matteo_claude_bot)"
  say "  4. BotFather replies with an ${GRN}HTTP API token${RST} — copy it"
  command -v open >/dev/null && open "https://t.me/BotFather" 2>/dev/null
  say ""

  local token="" bot_user=""
  while [ -z "$bot_user" ]; do
    printf "Paste the bot token (input hidden): "
    read -rs token; printf "\n"
    [ -z "$token" ] && { say "  ${YLW}empty — try again (Ctrl-C to abort).${RST}"; continue; }
    # curl | jq fails as a PIPELINE when the network is down. An empty answer sends the
    # loop round again with a readable message, which is what the user can act on.
    bot_user=$(tg_api "$token" getMe | jq -r 'select(.ok) .result.username // empty') || bot_user=""
    [ -z "$bot_user" ] && say "  ${RED}token rejected by the Telegram API${RST} — check for missing characters and retry."
  done
  ok "bot verified" "@$bot_user"

  # ── step 2: get your chat id ──
  say ""
  say "${YLW}Step 2/3 — link your account${RST}"
  say "  Open ${GRN}https://t.me/$bot_user${RST} (opening now…), press ${GRN}START${RST}, send any message."
  command -v open >/dev/null && open "https://t.me/$bot_user" 2>/dev/null
  printf "Press Enter once you've sent the message… "; read -r _

  local chat_id="" tries=0
  while [ -z "$chat_id" ] && [ $tries -lt 10 ]; do
    chat_id=$(tg_api "$token" getUpdates | jq -r '[.result[].message.chat.id] | last // empty') || chat_id=""
    [ -z "$chat_id" ] && { tries=$((tries+1)); say "  ${DIM}no message yet — retrying ($tries/10)…${RST}"; sleep 2; }
  done
  if [ -z "$chat_id" ]; then
    die "no message received by @$bot_user. Make sure you pressed START and sent something, then re-run: wellforge telegram"
  fi
  ok "chat detected" "id $chat_id"

  # ── step 3: persist + verify ──
  say ""
  say "${YLW}Step 3/3 — save and verify${RST}"
  mkdir -p "$(dirname "$TELEGRAM_ENV_FILE")"
  {
    echo "# WellForge Telegram notifications — written by 'wellforge telegram'. Never commit."
    echo "export TELEGRAM_BOT_TOKEN=\"$token\""
    echo "export TELEGRAM_CHAT_ID=\"$chat_id\""
  } > "$TELEGRAM_ENV_FILE"
  chmod 600 "$TELEGRAM_ENV_FILE"
  ok "saved" "$TELEGRAM_ENV_FILE (chmod 600)"

  local rc="$HOME/.zshrc" src_line="[ -f \"$TELEGRAM_ENV_FILE\" ] && . \"$TELEGRAM_ENV_FILE\""
  if ! grep -qsF "$TELEGRAM_ENV_FILE" "$rc"; then
    printf "\n# WellForge Telegram notifications\n%s\n" "$src_line" >> "$rc"
    ok "shell wired" "source line appended to ~/.zshrc"
  else
    # The tilde here is prose for the reader, not a path this code expands.
    # shellcheck disable=SC2088
    ok "shell wired" "~/.zshrc already sources it"
  fi

  export TELEGRAM_BOT_TOKEN="$token" TELEGRAM_CHAT_ID="$chat_id"
  tg_test || die "test message failed — check your network and re-run: wellforge telegram"
  say ""
  say "${GRN}done.${RST} ${DIM}Open a new terminal (or 'source ~/.zshrc') so Claude Code sessions inherit the vars.${RST}"
}

tg_test() {
  # shellcheck source=/dev/null
  [ -f "$TELEGRAM_ENV_FILE" ] && [ -z "${TELEGRAM_BOT_TOKEN:-}" ] && . "$TELEGRAM_ENV_FILE"
  local out
  out=$(tg_api "$TELEGRAM_BOT_TOKEN" sendMessage \
    -d "chat_id=${TELEGRAM_CHAT_ID}" \
    -d "text=🤖 WellForge: notifications are working." | jq -r '.ok') || out=""
  if [ "$out" = "true" ]; then ok "test message" "delivered — check Telegram"; return 0; fi
  bad "test message" "no 'ok' from the Telegram API (network down, or token/chat id wrong)"; return 1
}

# ─── commands ────────────────────────────────────────────────────────────────
cmd_doctor() {
  local fix=""
  [ "${1:-}" = "--fix" ] && fix=1
  FAILURES=0
  say "WellForge doctor ${DIM}(home: $WELLFORGE_HOME)${RST}"
  say ""
  say "tools:"
  check_brew
  # Not gated on brew: these tools can be installed any number of ways, and `command -v`
  # does not care which. Gating the loop meant a machine without brew got no line at all
  # for mise/uv/gh/jq — absence of evidence printed as absence of the tool.
  for t in "${BREW_TOOLS[@]}"; do check_tool "$t" "$fix"; done
  check_node "$fix"
  check_claude "$fix"
  check_docker
  check_gh_auth
  check_copier
  say ""
  say "wellforge:"
  check_repo
  check_plugin
  check_collisions "$fix"
  if telegram_configured; then ok "telegram" "configured ($TELEGRAM_ENV_FILE)"; else
    warn "telegram" "not configured (optional) — run: wellforge telegram"
  fi
  # ── the single exit path ──────────────────────────────────────────────────────────
  # Every check above reports and returns; none of them ends the run. This is the only
  # place doctor decides an exit status, which is what makes the summary unconditional:
  # a truncated doctor report is worse than a failing one, because it looks like a crash.
  say ""
  if [ "$FAILURES" -eq 0 ]; then
    say "${GRN}environment ready.${RST}"
  else
    if [ -n "$fix" ]; then
      say "${RED}$FAILURES check(s) failed.${RST} Some issues need manual action."
    else
      say "${RED}$FAILURES check(s) failed.${RST} Run: wellforge doctor --fix"
    fi
    # No checkout is the common first-run case, and `doctor --fix` does not create one —
    # only setup does. Say so, rather than sending the user round a loop that cannot help.
    if [ ! -f "$WELLFORGE_HOME/.claude-plugin/marketplace.json" ]; then
      say "${YLW}next:${RST} no checkout at $WELLFORGE_HOME — run: wellforge setup"
    fi
  fi
  [ "$FAILURES" -eq 0 ]
}

cmd_setup() {
  say "WellForge setup"
  command -v brew >/dev/null || die 'Homebrew first: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'

  # 1. install location (asked once, remembered; Enter keeps the default)
  if [ -t 0 ] && [ ! -f "$WELLFORGE_HOME/.claude-plugin/marketplace.json" ]; then
    printf "Install location [%s]: " "$WELLFORGE_HOME"
    read -r ans
    if [ -n "$ans" ]; then
      case "$ans" in "~"*) ans="$HOME${ans#\~}" ;; esac
      case "$ans" in /*) WELLFORGE_HOME="$ans" ;; *) die "use an absolute path (got: $ans)" ;; esac
    fi
  fi
  mkdir -p "$CONFIG_DIR" || die "cannot create $CONFIG_DIR — check permissions on $HOME/.config"
  echo "WELLFORGE_HOME=\"$WELLFORGE_HOME\"" > "$CONFIG_FILE" \
    || die "cannot write $CONFIG_FILE — check permissions"
  say "  ${DIM}home: $WELLFORGE_HOME (saved to $CONFIG_FILE)${RST}"

  # 2. repo
  if [ -f "$WELLFORGE_HOME/.claude-plugin/marketplace.json" ]; then
    say "  ${DIM}repo present — pulling latest…${RST}"
    git -C "$WELLFORGE_HOME" pull --ff-only 2>/dev/null || warn "repo" "pull skipped (no upstream yet)"
  else
    say "  ${DIM}cloning ${WELLFORGE_REPO}…${RST}"
    mkdir -p "$(dirname "$WELLFORGE_HOME")"
    git clone "$WELLFORGE_REPO" "$WELLFORGE_HOME" \
      || die "clone failed — private repo? run 'gh auth setup-git' or set WELLFORGE_REPO to an SSH URL"
  fi

  # 3. tools (doctor in fix mode does the installs/upgrades). Its non-zero means "checks
  # failed", not "setup cannot continue" — the remaining steps are still worth doing, and
  # the final doctor run below is what reports the outcome.
  cmd_doctor --fix

  # 4. marketplace + plugin (idempotent)
  if command -v claude >/dev/null; then
    local err
    if ! claude plugin marketplace list 2>/dev/null | grep -q "wellforge"; then
      if err=$(claude plugin marketplace add "$WELLFORGE_HOME" 2>&1 >/dev/null); then
        ok "marketplace" "registered from $WELLFORGE_HOME"
      else
        bad "marketplace" "add failed: $(err_tail "$err") — retry: claude plugin marketplace add $WELLFORGE_HOME"
      fi
    fi
    if ! claude plugin list 2>/dev/null | grep -q "wellforge"; then
      if err=$(claude plugin install wellforge@wellforge --scope user 2>&1 >/dev/null); then
        ok "plugin" "installed"
      else
        bad "plugin" "install failed: $(err_tail "$err") — retry: claude plugin install wellforge@wellforge --scope user"
      fi
    fi
  else
    warn "plugin" "claude not installed — skipped marketplace + plugin install"
  fi

  # 5. optional: Telegram notifications (interactive sessions only)
  if [ -t 0 ] && ! telegram_configured; then
    say ""
    printf "Enable Telegram notifications (DM when Claude needs permission / is waiting)? [y/N] "
    read -r ans
    case "$ans" in
      y|Y|yes) cmd_telegram ;;
      *) say "  ${DIM}skipped — run 'wellforge telegram' anytime.${RST}" ;;
    esac
  fi

  # Setup always ends by SAYING something. Previously this was `cmd_doctor && say "done"`,
  # so a single failing check ended the run on a bare non-zero with no closing line at all
  # — indistinguishable from a crash.
  say ""
  if cmd_doctor; then
    say "
${GRN}done.${RST} Open a Claude Code session and verify:
  /plugin   → wellforge installed
  /mcp      → sequential-thinking, playwright, github
Next: docs/QUICKSTART.md — /wellforge:new for your first project."
  else
    say "
${YLW}setup finished, but the checks above still report problems.${RST}
Fix the ✗ lines (each carries its command), then re-run: wellforge doctor"
    return 1
  fi
}

# Remove stale plugin cache version dirs, keeping only the current (source) version.
# Conservative: operates ONLY inside the wellforge cache root, only on X.Y.Z-shaped dir
# names, never the active version, and only when the current version is known.
prune_plugin_cache() {
  local cache_root="$HOME/.claude/plugins/cache/wellforge/wellforge"
  [ -d "$cache_root" ] || return 0
  local cur
  cur=$(plugin_json_version "$WELLFORGE_HOME/wellforge-plugin/.claude-plugin/plugin.json")
  [ -n "$cur" ] || return 0   # can't determine active version → never prune
  local removed=0 d name
  for d in "$cache_root"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    case "$name" in
      "$cur") continue ;;                                   # keep the active version
      [0-9]*.[0-9]*.[0-9]*) rm -rf "$d" 2>/dev/null && removed=$((removed+1)) ;;
      *) : ;;                                               # ignore non-version entries
    esac
  done
  if [ "$removed" -gt 0 ]; then ok "plugin cache" "pruned $removed stale version(s), kept v$cur"; fi
}

# True if this script is the brew-installed CLI (vs. run from a checkout).
is_brew_install() {
  local src
  src="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  case "$src" in */Cellar/wellforge/*) return 0 ;; *) return 1 ;; esac
}

cmd_update() {
  say "WellForge update"

  # Refresh brew metadata up front so the tool + CLI outdated-checks below are accurate.
  if command -v brew >/dev/null; then
    say "  ${DIM}refreshing brew metadata…${RST}"
    brew update >/dev/null 2>&1 \
      || warn "brew" "metadata refresh failed (offline?) — the outdated checks below may be stale"
  fi

  # 1. checkout (templates, gates, plugin source)
  if [ -d "$WELLFORGE_HOME/.git" ]; then
    git -C "$WELLFORGE_HOME" pull --ff-only 2>/dev/null \
      && ok "repo" "$(git -C "$WELLFORGE_HOME" describe --tags --match 'v*' --always 2>/dev/null)" \
      || warn "repo" "pull skipped (no upstream / local changes)"
  fi

  # 2. pinned dev tools
  if command -v brew >/dev/null; then
    local err
    for t in "${BREW_TOOLS[@]}"; do
      brew outdated --quiet 2>/dev/null | grep -qx "$t" || continue
      if err=$(brew upgrade "$t" 2>&1 >/dev/null); then
        ok "$t" "upgraded"
      else
        warn "$t" "upgrade failed, keeping the installed version — $(err_tail "$err") — retry: brew upgrade $t"
      fi
    done
  fi

  # 3. the LOADED plugin — Claude Code runs it from a version-keyed cache that neither
  # `git pull` nor /reload-plugins refreshes; only a reinstall does.
  if command -v claude >/dev/null && claude plugin list 2>/dev/null | grep -q "wellforge"; then
    claude plugin uninstall wellforge --scope user >/dev/null 2>&1 \
      || warn "plugin" "uninstall reported an error — continuing; the install below is what matters"
    local perr
    if perr=$(claude plugin install wellforge@wellforge --scope user 2>&1 >/dev/null); then
      ok "plugin" "reinstalled from source (cache refreshed)"
      prune_plugin_cache   # tidy stale version dirs now that the fresh one exists
    else
      warn "plugin" "reinstall failed: $(err_tail "$perr") — run: claude plugin install wellforge@wellforge --scope user"
    fi
  fi
  say "${DIM}plugin reloaded? run /reload-plugins (or start a new Claude Code session).${RST}"

  # 4. the CLI itself — LAST, because upgrading replaces this running binary. Bash keeps
  # the already-open script readable, and nothing of substance runs after this.
  if is_brew_install && command -v brew >/dev/null; then
    # `brew outdated <pkg>` exits 0 when current, non-zero when an upgrade exists.
    # (Don't grep `brew outdated --quiet` — it prints the TAP-QUALIFIED name
    #  matteocodogno/wellforge/wellforge, not bare "wellforge".)
    if brew outdated wellforge >/dev/null 2>&1; then
      ok "cli" "current"
    else
      say "  ${DIM}upgrading the wellforge CLI…${RST}"
      if brew upgrade wellforge >/dev/null 2>&1; then
        ok "cli" "upgraded to $(brew list --versions wellforge 2>/dev/null | awk '{print $2}' || echo '?') — active on next run"
      else
        warn "cli" "upgrade failed — run: brew upgrade wellforge"
      fi
    fi
  else
    say "${DIM}cli: running from a checkout (updated via the repo pull above) — not brew-managed.${RST}"
  fi
}

cmd_version() {
  # CLI version: derived from the brew Cellar path (no hardcoded constant to
  # forget at release time); a checkout run reports its git describe instead.
  local src ver="unknown"
  # resolve symlinks: brew links /opt/homebrew/bin/wellforge -> Cellar/…
  src="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
  src="$(cd "$(dirname "$src")" 2>/dev/null && pwd)" || src=""
  case "$src" in
    */Cellar/wellforge/*)
      ver="${src#*/Cellar/wellforge/}"; ver="${ver%%/*} (brew)" ;;
    *)
      local repo; repo="$(script_repo)"
      [ -n "$repo" ] && ver="$(git -C "$repo" describe --tags --match 'v*' --always 2>/dev/null || echo '?') (running from checkout)" ;;
  esac
  say "wellforge $ver"
  if [ -f "$WELLFORGE_HOME/.claude-plugin/marketplace.json" ]; then
    local desc fresh=""
    desc="$(git -C "$WELLFORGE_HOME" describe --tags --match 'v*' --always 2>/dev/null || echo '?')"
    # offline-safe freshness against the already-fetched ref (no network here)
    local behind; behind="$(git -C "$WELLFORGE_HOME" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
    [ "$behind" != "0" ] && fresh=" — ${behind} behind upstream, run: wellforge update"
    say "checkout:  $WELLFORGE_HOME ($desc)$fresh"
  else
    say "checkout:  none at $WELLFORGE_HOME — run: wellforge setup"
  fi
}

case "${1:-help}" in
  setup)    shift; cmd_setup "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  update)   shift; cmd_update "$@" ;;
  telegram) shift; cmd_telegram "$@" ;;
  version|--version|-v) cmd_version ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
