{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // Every .ts the linter sees must be in a project, or typed rules fail with a bare
  // "parserOptions.project has been provided" and no filename. tailwind.config.ts was
  // never listed — a gap that predates this release and only surfaced once the frontend
  // had a lint gate that ran at all.
  "include": ["src", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
