NODE_ENV=development
PORT=3000

# Logging
LOG_LEVEL=info
{% if db == "postgres" %}
# Database — NOTE: mise sets DATABASE_URL itself, derived from this checkout's identity so
# that two git worktrees never share one database (see the [env] block in mise.toml and
# `mise run wt:info`). This line documents the shape and is the value the PRIMARY tree
# resolves to; a linked worktree gets its own name and port. Anything you set in
# .mise.local.toml wins over both — `mise run db:guard` is what keeps that deliberate.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ project_slug | replace('-', '_') }}
{% endif %}