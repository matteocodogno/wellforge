# Dependencies
node_modules/

# Build output
dist/
coverage/
*.tsbuildinfo

# ─── Env files ───
# ALL of them are ignored, with no exception, because this project commits none. The
# frontend's public VITE_* defaults live in the root mise.toml [env] block and secrets live
# in .mise.local.toml (connections skill). The previous rules carved `.env` out of the ignore
# list so a committed `frontend/.env` could be tracked; that exception is what made a bare
# `.env` rule silently exclude a tracked file in v0.10.1.
.env
.env.local
.env.development
.env.production
.env.*.local

# mise local overrides — never commit
.mise.local.toml
.mise.*.local.toml

# Claude / WellForge local settings
.claude/settings.local.json
.claude/transcripts/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# WellForge run-trace token events (transient; keep semantic run JSONs committed)
.forge/runs/.events.jsonl

# WellForge visual-companion mockups (design evidence; transient, referenced from design.md)
.forge/design/
