name: Quality

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  # Linear history holds at EVERY rigor tier, like the security floor: a merge commit can't be
  # fixed retroactively without rewriting published history. Branches rebase onto main and
  # integrate fast-forward (see the repo's branch protection: required_linear_history).
  linear-history:
    name: linear history (no merge commits)
    uses: {{ gates_repo }}/.github/workflows/linear-history.yml@{{ gates_ref }}

{%- if rigor == 'spike' %}

  # rigor: spike — build sanity + the non-negotiable secret-scan floor only.
  # No coverage / SAST / eval. Raise with /wellforge:promote before this goes anywhere real.
  security-floor:
    name: Security floor (secrets)
    uses: {{ gates_repo }}/.github/workflows/security-floor.yml@{{ gates_ref }}

  build:
    name: Build (sanity)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: jdx/mise-action@v2
      - name: Build
        run: |
          mise run install
          mise run build
{%- else %}
  backend:
    name: Backend quality
    uses: {{ gates_repo }}/.github/workflows/quality-node.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
      working-directory: backend
      rigor: {{ rigor }}
{%- if db == 'postgres' %}
      # Integration tests get the same Postgres the project already runs locally. Add more
      # services (mailhog, redis, minio) to docker-compose.yml and CI picks them up — the
      # shared gate needs no change, because it starts YOUR compose file.
      compose-file: docker-compose.yml
      # backend/src/config/env.ts parses DATABASE_URL at import time, so tests need it set
      # even when they never touch the database. This file matches docker-compose.yml.
      env-file: backend/.env.example
      # Once the project has migrations, uncomment so integration tests meet a real schema:
      # pretest-command: pnpm db:migrate
{%- endif %}

  frontend:
    name: Frontend quality
    uses: {{ gates_repo }}/.github/workflows/quality-node.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
      working-directory: frontend
      rigor: {{ rigor }}

  commits:
    name: commit messages (Conventional Commits)
    uses: {{ gates_repo }}/.github/workflows/commit-lint.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
{%- endif %}
