name: heartbeat

# Scheduled "heartbeat" (WellForge Phase 14a) — re-runs the stack quality gate on a cadence
# to catch what PR-time gates cannot: CVEs newly disclosed against already-merged code (the
# advisory DB moves without a commit) and updated SAST rules. Findings are triaged into ONE
# deduplicated tracking issue by the reusable heartbeat-report workflow.
{% raw %}on:
  schedule:
    - cron: "{% endraw %}{{ heartbeat_cron }}{% raw %}"
  workflow_dispatch:

permissions:
  contents: read
  issues: write
{% endraw %}
jobs:
  backend:
    name: backend (Node)
    uses: {{ gates_repo }}/.github/workflows/quality-node.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
      working-directory: backend
      rigor: {{ rigor }}
{%- if db == 'postgres' %}
      # Integration tests get the same Postgres the project already runs locally. Add more
      # services (mailhog, redis, minio) to docker-compose.yml and CI picks them up — the
      # shared gate needs no change, because it starts YOUR compose file.
      compose-file: docker-compose.yml
      # backend/src/config/env.ts parses DATABASE_URL at import time, so tests need it set
      # even when they never touch the database. This file matches docker-compose.yml.
      env-file: backend/.env.example
      # Once the project has migrations, uncomment so integration tests meet a real schema:
      # pretest-command: pnpm db:migrate
{%- endif %}

  frontend:
    name: frontend (Node)
    uses: {{ gates_repo }}/.github/workflows/quality-node.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
      working-directory: frontend
      rigor: {{ rigor }}

  report:
    name: triage findings
    needs: [backend, frontend]
    if: always()
    uses: {{ gates_repo }}/.github/workflows/heartbeat-report.yml@{{ gates_ref }}
    with:
      failed: {% raw %}${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') }}
      run-url: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}

  # Pillar 6 lifecycle: has this project fallen behind its template? Files a separate
  # deduplicated "N releases behind → /wellforge:upgrade" issue; closes it when caught up.
  template-drift:
    name: template drift
    uses: {{ gates_repo }}/.github/workflows/template-drift.yml@{{ gates_ref }}
