{
  "permissions": {
    "allow": [
      "Bash(mise run:*)",
      "Bash(mise:*)",
      "Bash(pnpm:*)",
      "Bash(pulumi preview:*)",
      "Bash(pulumi config:*)",
      "Bash(pulumi stack:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.*.local)",
      "Read(./**/.envrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/secrets.yml)",
      "Read(./**/secrets.yaml)",
      "Read(./**/gcp-key*.json)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.development)",
      "Edit(./**/.env.production)",
      "Edit(./**/.env.*.local)",
      "Edit(./**/.envrc)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)",
      "Edit(./**/secrets.yml)",
      "Edit(./**/secrets.yaml)",
      "Edit(./**/gcp-key*.json)",
      "Read(./**/.mise.local.toml)",
      "Read(./**/credentials.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "wellforge": {
      "source": {
        "source": "github",
        "repo": "matteocodogno/wellforge"
      }
    }
  },
  "enabledPlugins": {
    "wellforge@wellforge": true
  }
}
