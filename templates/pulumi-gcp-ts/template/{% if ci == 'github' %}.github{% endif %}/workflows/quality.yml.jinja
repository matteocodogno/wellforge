name: Quality

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  # ── Tier-independent gates ──────────────────────────────────────────────────────────
  # These three run at EVERY rigor tier, and the reason is the same for all of them: none
  # can be repaired after the fact. A merge commit and a non-conventional message can only
  # be fixed by rewriting published history; a leaked credential can only be rotated, never
  # unpublished. Tiers trade off how much ceremony a CHANGE carries, never whether the
  # repository stays recoverable.
  #
  # They used to sit inside the rigor branch, which made them each other's blind spot:
  # security-floor ran only at `spike`, commit-lint only at `mvp`/`production`. An mvp
  # project — the default — had no secret scan in CI at all.
  linear-history:
    name: linear history (no merge commits)
    uses: {{ gates_repo }}/.github/workflows/linear-history.yml@{{ gates_ref }}

  commits:
    name: commit messages (Conventional Commits)
    uses: {{ gates_repo }}/.github/workflows/commit-lint.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}

  security-floor:
    name: security floor (secrets)
    uses: {{ gates_repo }}/.github/workflows/security-floor.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}

{%- if rigor == 'spike' %}

  # rigor: spike — build sanity only; the floor above already covers secrets, history and
  # commit messages at this tier. No coverage / SAST / eval. Raise with /wellforge:promote
  # before this goes anywhere real.
  #
  # ADVISORY (continue-on-error): the rigor-tiers skill puts lint/typecheck/build in the
  # advisory column at `spike` — measure and report, do not block. The result is still
  # visible in the summary, so the debt is honest rather than hidden.
  build:
    name: Compile (sanity)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v4
      - name: Compile-check the Pulumi program
        id: buildstep
        run: |
          mise run install
          mise run build
      - name: Report (advisory at spike)
        if: always()
        run: |
          # The raw guard below is load-bearing: a GitHub expression and a Jinja one are
          # spelled the same, so without it copier tries to resolve `steps` and the render
          # dies with "'steps' is undefined" (it did, before this line existed).
          if [ "{% raw %}${{ steps.buildstep.outcome }}{% endraw %}" = "success" ]; then
            echo "### compile: PASS" >> "$GITHUB_STEP_SUMMARY"
          else
            echo "### compile: FAIL (advisory at rigor=spike — not blocking)" >> "$GITHUB_STEP_SUMMARY"
            echo "Raise the tier with \`/wellforge:promote\` to make this block." >> "$GITHUB_STEP_SUMMARY"
          fi
{%- else %}
  infra:
    name: Infra quality
    uses: {{ gates_repo }}/.github/workflows/quality-node.yml@{{ gates_ref }}
    with:
      gates-repo: {{ gates_repo }}
      gates-ref: {{ gates_ref }}
      working-directory: infra
      rigor: {{ rigor }}

{%- endif %}

# NOTE: this workflow gates CODE QUALITY only (lint, typecheck, unit tests with Pulumi mocks,
# dependency audit, SAST). It never runs `pulumi preview`/`up` — that needs cloud credentials
# and belongs in a separate deploy workflow wired via Workload Identity Federation
# (see AGENTS.md → "Deploying"). Keeping deploy out of the quality gate keeps PR CI keyless.
